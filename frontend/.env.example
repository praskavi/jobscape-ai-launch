# Public Supabase values. These are intentionally exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key.
# Prefer this name for production. Do not expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy fallback currently supported by some routes.
# Prefer SUPABASE_SERVICE_ROLE_KEY for new deployments.
SUPABASE_SERVICE_ROLE=

# Server-only AI provider keys. Do not expose with NEXT_PUBLIC_.
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# Server-only comma-separated CORS allowlist for browser API requests.
# Localhost and 127.0.0.1 are allowed automatically for development.
CORS_ALLOWED_ORIGINS=https://jobscapeai.com,https://jobscrape-ai-j8fxn.ondigitalocean.app
